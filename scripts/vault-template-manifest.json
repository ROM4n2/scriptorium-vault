{
  "schema_version": 2,
  "description": "领域无关模板分发清单 v2（白名单优先，fail-closed）。定位转变（用户裁定 2026-09-10）：最终用户不一定是编程从业者，可能只是借用本模板学习任意领域——因此**引擎与治理规则随包，一切领域内容一律空壳化**。语义：keep = 原样分发；structure_only = 仅保留形态（内容由打包器清理/再生成）；exclude = 完全不出现在包内；stub_zones = 整个目录内容剔除，打包器在该目录生成引导 README（保留区结构）。**default.unmatched = exclude**。配套守卫：scripts/tests/test_template_manifest.py（schema / 无重叠 / 全区覆盖 / 领域无关 tripwire）。",
  "default": {
    "unmatched": "exclude",
    "rationale": "隐私与错位风险不可逆，内容缺失可补救——默认剔除而非默认保留。"
  },
  "keep": [
    {
      "pattern": "AGENTS.md",
      "rationale": "规范单一真值源（模板核心）"
    },
    {
      "pattern": "CLAUDE.md",
      "rationale": "多 Agent 入口（导出时物化为 AGENTS.md 内容副本）"
    },
    {
      "pattern": "GEMINI.md",
      "rationale": "多 Agent 入口（同上）"
    },
    {
      "pattern": ".cursorrules",
      "rationale": "多 Agent 入口（同上）"
    },
    {
      "pattern": ".windsurfrules",
      "rationale": "多 Agent 入口（同上）"
    },
    {
      "pattern": "CONVENTIONS.md",
      "rationale": "多 Agent 入口（同上）"
    },
    {
      "pattern": "README.md",
      "rationale": "库说明 + Clone 后必做 + 第 0 步 Obsidian 激活"
    },
    {
      "pattern": "TUTORIAL.md",
      "rationale": "使用教程（含无 Agent 手动路径）"
    },
    {
      "pattern": "LICENSE",
      "rationale": "代码许可（MIT）"
    },
    {
      "pattern": "LICENSE-CONTENT",
      "rationale": "内容许可（CC BY-SA 4.0）"
    },
    {
      "pattern": "requirements.txt",
      "rationale": "依赖声明（PyYAML + pytest）"
    },
    {
      "pattern": ".gitignore",
      "rationale": "忽略基线"
    },
    {
      "pattern": ".gitattributes",
      "rationale": "行尾纪律：shell/hooks MUST LF"
    },
    {
      "pattern": "scripts/**",
      "rationale": "**引擎**：事务/质量门/巡检/检索/仪表盘/账本/流转（模板真正价值）"
    },
    {
      "pattern": ".github/**",
      "rationale": "CI 工作流（pytest + quality + 洁净性 hermeticity）：接收者 fork 后自动校验，进包即用"
    },
    {
      "pattern": ".obsidian/snippets/**",
      "rationale": "**关键**：`vault-workbench.css` 是 Home 工作台的样式资产（`.gitignore` 已开例外）。此前漏在清单外，导致 README 第 0 步「已随库分发」的承诺与事实相反（2026-09-11 评估红牌）"
    },
    {
      "pattern": ".githooks/**",
      "rationale": "三道提交门本体"
    },
    {
      "pattern": "hooks/**",
      "rationale": "hooks.json 门禁 manifest"
    },
    {
      "pattern": ".claude/**",
      "rationale": "L2 技能定义 + hooks + settings（healthcheck Check 8 硬校验）"
    },
    {
      "pattern": "Templates/**",
      "rationale": "笔记类模板 14 个 + WORKMEMORY 件套（含 {{VAULT_ROOT}} 占位符）"
    },
    {
      "pattern": "examples/**",
      "rationale": "**最小示例组**：中性领域双版本笔记 + ADR + RCA，展示合规笔记格式"
    },
    {
      "pattern": "skills/**",
      "rationale": "**随包技能子集**（11 个领域无关的 `/vault-*` 技能 + 安装说明）：不装也能用，装了体验完整；白名单由 test_shipped_skills.py 钉死"
    },
    {
      "pattern": "00-MOC/Home.md",
      "rationale": "总控工作台（已泛化：控制舱+热力图保留，导航表去领域化）"
    },
    {
